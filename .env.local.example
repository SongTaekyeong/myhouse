# 로컬 개발용 환경변수 예시. 실제 값을 채운 뒤 .env.local 로 복사해서 쓸 것.
# .env.local 은 .gitignore 에 걸려있어 커밋되지 않는다.

# --- app DB (postgis) ---
POSTGRES_USER=naejip
POSTGRES_PASSWORD=changeme
POSTGRES_DB=naejip
# 5432가 로컬에 이미 다른 postgres로 점유돼 있으면 5433처럼 다른 값으로
POSTGRES_PORT=5432

# --- airflow metadata DB (별도 postgres) ---
AIRFLOW_DB_PASSWORD=changeme

# --- airflow core ---
# 생성: docker run --rm apache/airflow:2.9.3 python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
# 생성: openssl rand -hex 30
AIRFLOW_WEBSERVER_SECRET_KEY=

AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=changeme

# --- 공공데이터포털(국토부 실거래·단지정보) 서비스 키 ---
DATA_GO_KR_SERVICE_KEY=

# --- 카카오 로컬(주소 검색) API - 서버 전용, 프론트로 내려보내지 말 것 ---
KAKAO_REST_API_KEY=

# --- backend (FastAPI) ---
APP_ENV=development
# 운영에서 true면 부팅 실패해야 함 (SPEC.md §10)
AUTH_DISABLED=true
# 콤마로 구분된 화이트리스트 이메일 2개
ALLOWED_EMAILS=
# frontend/.env.local 의 INTERNAL_API_SECRET과 반드시 같은 값이어야 함
# 생성: openssl rand -hex 32
INTERNAL_API_SECRET=changeme
CORS_ORIGINS=http://localhost:3000
