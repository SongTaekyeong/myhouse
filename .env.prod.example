# 운영(VM)용 환경변수 예시. VM에서 .env.prod 로 복사해 값을 채운 뒤
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
# .env.prod 는 .gitignore에 걸려 있어야 한다 - 커밋 금지, VM에만 존재.

# --- 어느 도메인으로 뜰지 ---
DOMAIN=example.com

# --- 이미지 태그 (GitHub Actions가 GHCR에 올린 걸 그대로 씀) ---
BACKEND_IMAGE=ghcr.io/<github-user>/naejip-backend:latest
FRONTEND_IMAGE=ghcr.io/<github-user>/naejip-frontend:latest

# --- app DB (postgis) ---
POSTGRES_USER=naejip
POSTGRES_PASSWORD=changeme
POSTGRES_DB=naejip

# --- backend (FastAPI) ---
# 콤마로 구분된 화이트리스트 이메일 2개 (개발용 .env.local과 같은 값이어도 됨)
ALLOWED_EMAILS=
# frontend와 반드시 같은 값 - 생성: openssl rand -hex 32
INTERNAL_API_SECRET=changeme

# --- Auth.js (Google OAuth) ---
# 생성: openssl rand -base64 32
AUTH_SECRET=changeme
# Google Cloud Console에서 운영 도메인의 콜백 URL도 추가로 등록해야 함
# (https://<DOMAIN>/api/auth/callback/google)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
